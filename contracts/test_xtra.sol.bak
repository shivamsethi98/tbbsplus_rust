    /// @notice Verify a third Schnorr relation for encryption: bases (A', Ybar), instance T2enc
    /// Checks A' * respA3 + Ybar * respK == Tenc + T2enc * c
    function verifyEnc(
        bytes memory APrime,
        bytes memory Ybar,
        bytes memory T2enc,
        bytes memory Tenc,
        uint256 respA3,
        uint256 respK,
        uint256 challenge
    ) internal view returns (bool) {
        if (APrime.length != 128 || Ybar.length != 128 || T2enc.length != 128 || Tenc.length != 128) revert BadLen();
        // Compute LHS using only single-pair MSM + G1ADD: lhs = (A'*sA3) + (Ybar*sK)
        uint256 sA3 = respA3 % FR_MODULUS;
        uint256 sK = respK % FR_MODULUS;
        bytes[] memory onePt = new bytes[](1);
        uint256[] memory oneSc = new uint256[](1);
        onePt[0] = APrime; oneSc[0] = sA3;
        bytes memory a3Term = Bls12381.g1msm(Bls12381.concatMSM(onePt, oneSc));
        onePt[0] = Ybar;   oneSc[0] = sK;
        bytes memory kTerm = Bls12381.g1msm(Bls12381.concatMSM(onePt, oneSc));
        bytes memory lhs = Bls12381.g1add(a3Term, kTerm);

        // Compute RHS using single-pair MSM + G1ADD: rhs = Tenc + (T2enc * c)
        uint256 c = challenge % FR_MODULUS;
        onePt[0] = T2enc;  oneSc[0] = c;
        bytes memory cT2 = Bls12381.g1msm(Bls12381.concatMSM(onePt, oneSc));
        bytes memory rhs = Bls12381.g1add(Tenc, cT2);

        return keccak256(lhs) == keccak256(rhs);
    }